# =============================================================================
# Task Manager API — environment variables
# =============================================================================
# Copy this file to `.env` at the repository root and fill in your values:
#   cp .env.example .env
#
# ASP.NET Core binds SECTION__KEY (double underscore) to nested configuration.
# Variables set here override appsettings.json.
# =============================================================================

# --- Application ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:5001;http://localhost:5000

# --- SQL Server ---
# Full connection string (recommended)
CONNECTIONSTRINGS__DEFAULTCONNECTION=Server=localhost,1433;Database=TaskManagerDb;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;MultipleActiveResultSets=true

# Optional: build connection string from parts (uncomment and leave DEFAULTCONNECTION empty if you add builder support later)
# DB_SERVER=localhost,1433
# DB_NAME=TaskManagerDb
# DB_USER=sa
# DB_PASSWORD=YourStrong@Passw0rd

# --- JWT authentication ---
JWT__SECRET=CHANGE_ME_TO_A_SECURE_KEY_AT_LEAST_32_CHARACTERS_LONG
JWT__ISSUER=TaskManager.Api
JWT__AUDIENCE=TaskManager.Client
JWT__EXPIRATIONHOURS=24

# --- Logging (optional overrides) ---
# Logging__LogLevel__Default=Information
# Logging__LogLevel__Microsoft.AspNetCore=Warning
# Logging__LogLevel__Microsoft.EntityFrameworkCore=Warning
